# ============================================================
# 智慧农业云管端一体化平台 · 环境变量示例
# ------------------------------------------------------------
# 用法：
#   1) 复制本文件为同目录下的 .env      cp .env.example .env
#   2) 按需修改（下面全部是本地演示值，改了才不会跟别人撞）
#   3) docker compose up 会自动读取 .env
#      本地 java -jar 运行时，需自行 export 这些变量（或写进 IDE 运行配置）
#
# 约定：application.yml 里都是 ${VAR:演示默认值} 形式。
#       .env 里不写某一行 → 就退回 yml 里的演示默认值，仍然能跑。
#       .env 已被 .gitignore 忽略，不会进仓库。
# ============================================================

# ---------- 服务端口 ----------
SERVER_PORT=8080
MQTT_PORT=1883

# ---------- 数据库 ----------
# 默认 dev 用文件型 H2（DB_PATH 是数据库文件前缀，相对启动目录）
DB_PATH=./data/agri
DB_USERNAME=sa
DB_PASSWORD=
# 切到 mysql profile 时才用下面这组
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agri
# MySQL root 密码（仅 docker-compose 启动 mysql 容器时使用）
DB_ROOT_PASSWORD=root123

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- InfluxDB ----------
INFLUX_URL=http://localhost:8086
# 需与 docker-compose 里 DOCKER_INFLUXDB_INIT_ADMIN_TOKEN 保持一致
INFLUX_TOKEN=my-super-token
INFLUX_ORG=smart-agri
INFLUX_BUCKET=agri-raw
INFLUX_DOWNSAMPLE_BUCKET=agri-1m
# 数据分层保留（天）。改小前先想清楚：降采样 task 停摆 + raw 到期 = 数据永久丢且无信号
INFLUX_RAW_RETENTION_DAYS=30
INFLUX_DOWNSAMPLE_RETENTION_DAYS=365
# 降采样健康检查：任务停摆时应用完全无感，必须自己探
INFLUX_TASK_HEALTH_MS=300000
# ds 落后 raw 超过这个毫秒数判停摆（task 每 1 分钟跑一次，留 10 倍余量）
INFLUX_TASK_LAG_MS=600000
# 判停摆后把 raw retention 临时拉到这里止血，补算成功才调回
INFLUX_RESCUE_RETENTION_DAYS=365
# 恢复后自动补算的最大跨度（小时），超过只补最近一段
INFLUX_BACKFILL_MAX_HOURS=72
# 仅 docker-compose 首次初始化 InfluxDB 时使用
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=admin123

# ---------- RabbitMQ（mq.enabled=true 时才连接）----------
MQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- 鉴权 ----------
# JWT 签名密钥：HS256 要求 ≥32 字节，生产请换成随机串
# 生成一个：openssl rand -base64 48
JWT_SECRET=smart-agriculture-cloud-platform-secret-key-2026-change-me-please
JWT_EXPIRATION_MS=86400000

# MQTT 模拟器专用服务账号（device_sim.py 与后端共用）
MQTT_SIM_USERNAME=simulator
MQTT_SIM_SECRET=sim-secret-2026-change-me

# ---------- 设备模拟器 ----------
SIMULATOR_PYTHON=python
SIMULATOR_BROKER_HOST=127.0.0.1
SIMULATOR_BROKER_PORT=1883

# ---------- API 治理 ----------
# true：/api/** 与 /api/v1/** 同时可用；下线旧版时改 false
API_LEGACY_COMPAT=true

# ---------- 资源守卫（演示态保护）----------
# 本机资源紧张时只给"节流建议"（降采样率），不会自动切内存存储
# 演示机建议 0.5（IDE + 浏览器常驻），生产机 0.8
CAPACITY_CPU_THRESHOLD=0.7
CAPACITY_HEAP_THRESHOLD=0.8
CAPACITY_SAMPLE_MS=5000

# ---------- AI 告警解读（OpenAI 兼容网关）----------
# 总开关。false 或 api-key 为空时不会发任何外部请求，自动降级为本地规则模板
# （大屏上会标注 LOCAL，用户能分清「模型生成」和「规则兜底」）
LLM_ENABLED=false

# 联通云 AISP 的 OpenAI 兼容网关（三地任选其一，选离你近的）
#   贵阳基地二区  https://aigw-gzgy2.cucloud.cn:8443/v1
#   呼和浩特      https://aigw-nmhhht.cucloud.cn/v1
#   上海          https://aigw-sh22.cucloud.cn/v1
LLM_BASE_URL=https://aigw-gzgy2.cucloud.cn:8443/v1

# 控制台「API Key 管理」里创建的 key，形如 sk-xxxx
# 注意：这一行填了真 key 之后，.env 只在本地存在，已被 .gitignore 忽略
LLM_API_KEY=

# 模型名需与网关文档完全一致。DeepSeek-V4-Flash 是尝鲜资源（200K 上下文），
# 高峰期容易限流；被限流时熔断会兜住，不会拖慢告警链路
LLM_MODEL=DeepSeek-V4-Flash

LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_CONNECT_TIMEOUT_MS=5000
# 流式响应总时长上限（毫秒）；超时按调用失败处理并降级
LLM_STREAM_TIMEOUT_MS=60000

# 告警自动解读：只解读 CRITICAL 及以上，同设备同规则 60 秒内只解读一次
LLM_AUTO_EXPLAIN=true
LLM_MIN_SEVERITY=CRITICAL
LLM_THROTTLE_SECONDS=60
LLM_PERSIST=true
