# 统一换行符，避免 Windows 提交的脚本在 Linux 上跑不了
* text=auto

*.sh    text eol=lf
mvnw    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.md    text eol=lf
LICENSE text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.java  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.svg   text eol=lf

# 二进制文件不做换行转换
*.jar   binary
*.png   binary
*.db    binary
